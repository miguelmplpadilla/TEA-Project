rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function friendRequestPath(firstUid, secondUid) {
      return /databases/$(database)/documents/friendRequests/$(firstUid + '_' + secondUid);
    }

    function friendshipPath(firstUid, secondUid) {
      return /databases/$(database)/documents/friendships/$(firstUid + '_' + secondUid);
    }

    function isFriendWith(uid) {
      return exists(friendshipPath(request.auth.uid, uid)) ||
        exists(friendshipPath(uid, request.auth.uid));
    }

    function acceptedRequestExists(firstUid, secondUid) {
      return (
        exists(friendRequestPath(firstUid, secondUid)) &&
        getAfter(friendRequestPath(firstUid, secondUid)).data.status == 'accepted'
      ) || (
        exists(friendRequestPath(secondUid, firstUid)) &&
        getAfter(friendRequestPath(secondUid, firstUid)).data.status == 'accepted'
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.userName is string &&
        request.resource.data.userNameLower is string;
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /usernames/{userNameLower} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.userName is string;
      allow update, delete: if false;
    }

    match /publications/{publicationId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        changedKeys().hasOnly(['comments', 'updatedAt'])
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /psychologistVerificationRequests/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.declaredPsychologist == true;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get, list: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !exists(friendshipPath(request.resource.data.fromUid, request.resource.data.toUid)) &&
        !exists(friendshipPath(request.resource.data.toUid, request.resource.data.fromUid));
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        changedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn() && (
        request.auth.uid in resource.data.uids ||
        isFriendWith(resource.data.uids[0]) ||
        isFriendWith(resource.data.uids[1])
      );
      allow list: if signedIn() &&
        request.auth.uid in resource.data.uids;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.uids &&
        request.resource.data.acceptedByUid == request.auth.uid &&
        request.resource.data.requestedByUid is string &&
        request.resource.data.requestedByUid in request.resource.data.uids &&
        acceptedRequestExists(
          request.resource.data.uids[0],
          request.resource.data.uids[1]
        );
      allow update, delete: if false;
    }

    match /friendNotifications/{notificationId} {
      allow get, list: if signedIn() &&
        resource.data.toUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.type == 'friend_request_accepted';
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        changedKeys().hasOnly(['seenAt']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
